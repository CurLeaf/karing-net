<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KARING_DATA_DIR</key>
		<string>__KARING_DIR__</string>
		<key>KARING_STATE_DIR</key>
		<string>__STATE_DIR__</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>15</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.karing.net.gc</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROJECT_DIR__/.vfox/sdks/python/bin/python3</string>
		<string>__PROJECT_DIR__/connection_gc.py</string>
		<string>--apply</string>
		<string>--loop</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
